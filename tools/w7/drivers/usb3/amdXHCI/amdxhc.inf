;/*++
;
;(C) Copyright 2014-2018  Advanced Micro Devices, Inc.
;
;Module Name:
;
;    amdhub3.inf
;
;Abstract:
;    INF file for installing AMD USB3 Controller Driver.
;
;--*/

[Version]
Signature="$Windows NT$"
Class=USB
ClassGuid={36FC9E60-C465-11CF-8056-444553540000}
Provider=%AMD%
DriverVer = 01/01/1970,0.0.0.1
CatalogFile=amdxhci.cat

[SourceDisksNames]
1 = %DISKID%

[SourceDisksFiles.amd64]
amdxhci.sys = 1, 



[DestinationDirs]
DefaultDestDir = 12 

[Manufacturer]
%AMD% = AMD, NTamd64.6.0

[AMD.NTamd64.6.0]
%AMDXHCI.DeviceDesc% = AMDXHCI, PCI\CC_0C0330
%AMDXHCI.DeviceDesc% = AMDXHCI, ACPI\PNP0D10
%AMDXHCI.DeviceDesc% = AMDXHCI, ACPI\PNP0D15

[DefaultInstall]
CopyINF = amdxhci.inf

;---------------------
; AMDXHCI
;---------------------
[AMDXHCI.NT]
CopyFiles = AMDXHCI.CopyFiles
ExcludeId = PCI\VEN_1022&DEV_149C&CC_0C0330

[AMDXHCI.CopyFiles]
amdxhci.sys

[AMDXHCI.NT.HW]
AddReg = AMDXHCI.AddReg.HW

[AMDXHCI.AddReg.HW]
HKR,"Interrupt Management\MessageSignaledInterruptProperties",MSISupported,0x00010001,1

[AMDXHCI.NT.Services]
AddService = amdxhci, 0x00000002, AMDXHCI.AddService, AMDXHCI.EventLog

[AMDXHCI.AddService]
DisplayName    = %AMDXHCI.SvcDesc%
ServiceType    = 1                 ; SERVICE_KERNEL_DRIVER
StartType      = 3                 ; SERVICE_DEMAND_START 
ErrorControl   = 1                 ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\amdxhci.sys
LoadOrderGroup = Base

[AMDXHCI.EventLog]
AddReg = AMDXHCI.EventLog.AddReg

[AMDXHCI.EventLog.AddReg]
HKR,,"EventMessageFile",0x00020000,"%11%\iologmsg.dll;%12%\amdxhci.sys"
HKR,,"TypesSupported",0x00010001,7

[Strings]
AMD               = "Advanced Micro Devices, Inc"
DISKID            = "Generic USB XHCI Device Driver Installation Disk"
AMDXHCI.SvcDesc    = "Generic XHCI Host Controller Driver"
AMDXHCI.DeviceDesc = "Generic XHCI Host Controller"
